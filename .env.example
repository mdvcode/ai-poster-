TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID; only this user can control the bot in private chat.
OWNER_ID=
# Choose anthropic (Claude) or openai. Only the selected provider's key is required.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional alternative provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Leave empty to use the same model; override with a model from the selected provider.
VERIFY_MODEL=
# Telegram sources use anonymous public previews; no personal account login.
# Optional: official X API bearer token with timeline read access.
X_BEARER_TOKEN=
DATABASE_PATH=data/poster.sqlite3
POLL_INTERVAL_SECONDS=300
PUBLISH_INTERVAL_SECONDS=60
MAX_POSTS_PER_CYCLE=5
OUTPUT_LANGUAGE=English
WEB_ENABLED=true
WEB_PORT=8765
